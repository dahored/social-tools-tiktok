# ── Server ────────────────────────────────────────────────────────────────────
PORT=4050
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=this-is-my-secrect-social-tools-tiktok-371995
JWT_EXPIRES_IN=7d

# ── Database provider: 'file' | 'mongo' | 'supabase' ─────────────────────────
DB_PROVIDER=mongo

# ── MongoDB (required when DB_PROVIDER=mongo) ─────────────────────────────────
MONGO_URI=mongodb://localhost:27017/social-tools-tiktok

# ── Supabase (required when DB_PROVIDER=supabase) ────────────────────────────
# Use service_role key (NOT anon key) for backend-only usage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-service-role-key-here
