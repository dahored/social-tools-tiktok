# ── Server ────────────────────────────────────────────────────────────────────
PORT=4050
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# ── Database provider: 'file' | 'mongo' | 'supabase' ─────────────────────────
DB_PROVIDER=file

# ── MongoDB (required when DB_PROVIDER=mongo) ─────────────────────────────────
MONGO_URI=mongodb://localhost:27017/social-tools-tiktok

# ── Supabase (required when DB_PROVIDER=supabase) ────────────────────────────
# Use service_role key (NOT anon key) for backend-only usage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-service-role-key-here

# Optional: Euler Stream key for TikTok chat (free tier is rate-limited without it)
TIKTOK_SIGN_API_KEY=

# Optional: Facebook Page live comments (chat overlay → Conectar Facebook)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Only for "Facebook Login for Business" apps: the login configuration ID
FACEBOOK_CONFIG_ID=
# PUBLIC_URL=http://localhost:4050   # only if you open the app from another address
